# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit .env)
POSTGRES_USER=diabetes_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=diabetes_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ไฟล์ CSV จาก Kaggle
CSV_PATH=data/diabetes_dataset_with_notes.csv
RAW_TABLE=diabetes_dataset_with_notes

# Google Sheets (ดูวิธีตั้งค่าใน README)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SPREADSHEET_ID=ใส่_ID_ของ_Google_Sheet_ตรงนี้
